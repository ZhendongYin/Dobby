# Development image: Mix + assets tooling inside the container.
# Source is mounted from the host via docker-compose.dev.yml; deps/_build use
# named volumes so Linux builds are not mixed with macOS host artifacts.
FROM elixir:1.15.4

RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential \
    git \
    curl \
    postgresql-client \
    inotify-tools \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app

ENV MIX_ENV=dev \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Optional: non-root user could be added later for stricter dev setups.
